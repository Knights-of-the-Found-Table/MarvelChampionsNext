# Optional card-image mirror settings — copy to .env in the repo root.
# Read by the server on startup (dev and bare-metal runs) and passed into
# the docker container by deploy/docker-compose.yml (env_file). Real
# environment variables always win over this file.

# Private Cloudflare R2 mirror, used directly as the preferred image
# source (read-only). It serves marvelcdb's exact paths
# (/bundles/cards/{code}.jpg) — whatever it holds is what the server
# distributes (with this bucket: the Chinese card pack, so every served
# image is Chinese). Codes the mirror lacks fall back to marvelcdb.
# Paths from card data end in .png and are retried as .jpg automatically.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# HTTP mirror of marvelcdb (optional; defaults to the site itself). Must
# serve marvelcdb's path layout.
#MC_MARVELCDB_IMAGES=https://marvelcdb.example.com

# Background cache prewarm at startup (auto = on when a mirror is
# configured, so every image URL gets content-hashed).
#MC_PREWARM_IMAGES=auto
