# Optional card-image mirror settings — copy to .env in the repo root.
# Read by the server on startup (dev and bare-metal runs) and passed into
# the docker container by deploy/docker-compose.yml (env_file). Real
# environment variables always win over this file.

# Default-language (English) image mirror root (optional; defaults to
# https://marvelcdb.com). Must serve marvelcdb's exact path layout
# (/bundles/cards/{code}.png).
#IMAGE_MIRROR=https://images.example.com

# Chinese image mirror root: a separate language source with the same
# marvelcdb paths (like marvelcdb's own language domains). Configured, the
# zh cache fetches from it on demand; codes it lacks fall back to the
# default root. Paths are requested exactly as in the card data (.png and
# .jpg mixed), with a .png/.jpg/.webp extension retry for mirrors keyed
# differently; the file format is detected from content.
#ZH_IMAGE_MIRROR=https://zh-images.example.com

# Background cache prewarm at startup (auto = on for every mirror-backed
# cache, so every image URL gets content-hashed).
#MC_PREWARM_IMAGES=auto
