# Optional card-image mirror settings — copy to .env in the repo root.
# Read by the server on startup (dev and bare-metal runs) and passed into
# the docker container by deploy/docker-compose.yml (env_file). Real
# environment variables always win over this file.

# Default-language (English) image mirror root (optional; defaults to
# https://marvelcdb.com). Keyed by the face convention
# /bundles/cards/{code}.png ({base}a = A face, {base}b = B face), with a
# .png/.jpg/.webp extension retry. The marvelcdb.com default is
# special-cased to its own legacy per-face paths.
#IMAGE_MIRROR=https://images.example.com

# Chinese image mirror root: a separate language source keyed by the face
# convention /bundles/cards/{code}.png ({base}a = A face, {base}b = B face).
# Configured, the zh cache fetches from it on demand; codes it lacks fall
# back to the default root. Locally seeded faces (tools/seed_zh_images.py)
# always take priority. Run tools/zh/audit_mirror.py for a gap report
# against this mirror.
#ZH_IMAGE_MIRROR=https://zh-images.example.com

# Background cache prewarm at startup, off by default. Set to 1 to fill
# the hash manifest for every card image at boot (the default chain, and
# the zh chain when ZH_IMAGE_MIRROR is configured).
#MC_PREWARM_IMAGES=1

# Server log level for the structured stderr log: debug | info | warn |
# error (default info).
#MC_LOG_LEVEL=info
