# Copy to deploy/.env (docker compose reads it automatically).
# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Any restart keeps tokens valid as long as this value stays the same.
MC_JWT_SECRET=change-me

# Card-image mirrors (R2_* for the Chinese pack, MC_MARVELCDB_IMAGES for an
# English HTTP mirror) live in the repo-root .env — see ../.env.example.
# docker-compose passes that file into the container via env_file.
